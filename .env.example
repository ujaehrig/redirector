PORT=8080
DB_BACKEND=sqlite
SQLITE_PATH=./redirects.db
DYNAMODB_TABLE=redirects
AWS_REGION=eu-central-1

# JWT Authentication
JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
JWT_ISSUER=https://your-idp.example.com/
JWT_AUDIENCE=your-client-id
JWT_GROUPS_CLAIM=groups
ADMIN_GROUP=admin

# CLI mode (local = direct DB, api = HTTP with Bearer token)
CLI_MODE=local
API_URL=http://localhost:8080
API_TOKEN=
